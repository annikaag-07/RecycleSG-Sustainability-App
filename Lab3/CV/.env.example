# Copy this file to .env and paste your key. Never commit .env.
GEMINI_API_KEY=your-key-here
# Optional: run `python classifier.py --list-models` and paste a model id here
GEMINI_MODEL=gemini-flash-lite-latest
# Below this confidence the app asks the user to pick manually
CV_CONFIDENCE_THRESHOLD=0.6
# Server-only verification connection. Never use these in EXPO_PUBLIC_* variables.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
