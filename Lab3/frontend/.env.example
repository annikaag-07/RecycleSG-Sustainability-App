# Copy to .env (git-ignored) and fill in.
# Local backend: run `npx supabase@2 status` in Lab3/backend and copy API_URL and ANON_KEY.
# Hosted backend: ask the backend owner for the project URL and anon/publishable key.
# NEVER put the service-role / secret key here — EXPO_PUBLIC_ values are bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# URL of the trusted FastAPI verification service (no secrets in frontend).
EXPO_PUBLIC_VERIFICATION_URL=http://127.0.0.1:8000
